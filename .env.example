COMPOSE_PROJECT_NAME=revive
REVIVE_VERSION=6.0.8
REVIVE_SHA256=8ea81978b876bfeeea1a985e2b9a2bc9a62b1e6fc9bad99e4756a933f588b38d
MARIADB_IMAGE=mariadb:11.4
DB_NAME=revive
