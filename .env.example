# Browser installer by default. Opt-in CLI install needs all three admin fields.
REVIVE_AUTO_INSTALL=0
REVIVE_ADMIN_USERNAME=
REVIVE_ADMIN_PASSWORD=
REVIVE_ADMIN_EMAIL=